using Gtk 4.0;
using Adw 1;

template $GlanceWindow: Adw.ApplicationWindow {
  default-width: 960;
  default-height: 680;
  title: _("Glance");

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        [start]
        Button {
          focus-on-click: false;
          icon-name: "document-open-symbolic";
          tooltip-text: _("Open…");
          action-name: "win.open";
        }

        title-widget: Adw.WindowTitle window_title {
          title: _("Glance");
        };

        [end]
        MenuButton {
          focus-on-click: false;
          primary: true;
          icon-name: "open-menu-symbolic";
          tooltip-text: _("Main Menu");
          menu-model: primary_menu;
        }

        [end]
        ToggleButton {
          focus-on-click: false;
          icon-name: "glance-markup-symbolic";
          tooltip-text: _("Markup");
          action-name: "win.markup";
        }

        [end]
        Button {
          focus-on-click: false;
          icon-name: "object-rotate-left-symbolic";
          tooltip-text: _("Rotate Left");
          action-name: "win.rotate-left";
        }

        [end]
        Box {
          styles [
            "linked",
          ]

          Button {

            focus-on-click: false;
            icon-name: "zoom-out-symbolic";
            tooltip-text: _("Zoom Out");
            action-name: "win.zoom-out";
          }

          Button {

            focus-on-click: false;
            icon-name: "zoom-in-symbolic";
            tooltip-text: _("Zoom In");
            action-name: "win.zoom-in";
          }
        }

        [end]
        MenuButton info_button {
          focus-on-click: false;
          icon-name: "help-about-symbolic";
          tooltip-text: _("Info");

          popover: Popover {
            child: Grid info_grid {
              row-spacing: 6;
              column-spacing: 12;
              margin-top: 6;
              margin-bottom: 6;
              margin-start: 6;
              margin-end: 6;
            };
          };
        }
      }

      [top]
      Box markup_bar {
        visible: false;
        spacing: 12;
        margin-start: 6;
        margin-end: 6;
        margin-bottom: 6;
        halign: center;

        Box {
          styles [
            "linked",
          ]

          ToggleButton {
            focus-on-click: false;
            icon-name: "glance-tool-select-symbolic";
            tooltip-text: _("Select");
            action-name: "win.markup-tool";
            action-target: "'select'";
          }

          ToggleButton {
            focus-on-click: false;
            icon-name: "glance-tool-rect-symbolic";
            tooltip-text: _("Rectangle");
            action-name: "win.markup-tool";
            action-target: "'rect'";
          }

          ToggleButton {
            focus-on-click: false;
            icon-name: "glance-tool-ellipse-symbolic";
            tooltip-text: _("Oval");
            action-name: "win.markup-tool";
            action-target: "'ellipse'";
          }

          ToggleButton {
            focus-on-click: false;
            icon-name: "glance-tool-line-symbolic";
            tooltip-text: _("Line");
            action-name: "win.markup-tool";
            action-target: "'line'";
          }

          ToggleButton {
            focus-on-click: false;
            icon-name: "glance-tool-arrow-symbolic";
            tooltip-text: _("Arrow");
            action-name: "win.markup-tool";
            action-target: "'arrow'";
          }

          ToggleButton {
            focus-on-click: false;
            icon-name: "glance-tool-highlight-symbolic";
            tooltip-text: _("Highlight");
            action-name: "win.markup-tool";
            action-target: "'highlight'";
          }

          ToggleButton {
            focus-on-click: false;
            icon-name: "glance-tool-text-symbolic";
            tooltip-text: _("Text");
            action-name: "win.markup-tool";
            action-target: "'text'";
          }
        }

        Separator {}

        Box swatches {
          spacing: 2;
        }

        ColorDialogButton custom_color {
          focus-on-click: false;
          valign: center;
          tooltip-text: _("Custom Colour");

          dialog: ColorDialog {
            with-alpha: false;
          };
        }

        MenuButton {
          focus-on-click: false;
          icon-name: "glance-weight-symbolic";
          tooltip-text: _("Line Width and Text Size");
          menu-model: weight_menu;
        }

        Button {
          focus-on-click: false;
          icon-name: "user-trash-symbolic";
          tooltip-text: _("Delete Shape");
          action-name: "win.markup-delete";
        }
      }

      content: Stack stack {
        StackPage {
          name: "empty";

          child: Adw.StatusPage {
            icon-name: "image-x-generic-symbolic";
            title: _("No Image Open");
            description: _("Drag an image here, or open one");

            child: Button {
              label: _("_Open…");
              use-underline: true;
              halign: center;
              action-name: "win.open";

              styles [
                "pill",
                "suggested-action",
              ]
            };
          };
        }

        StackPage {
          name: "image";
          child: $GlanceCanvas canvas {};
        }
      };
    };
  };
}

menu weight_menu {
  section {
    item {
      label: _("Thin");
      action: "win.markup-weight";
      target: "thin";
    }

    item {
      label: _("Medium");
      action: "win.markup-weight";
      target: "medium";
    }

    item {
      label: _("Thick");
      action: "win.markup-weight";
      target: "thick";
    }
  }
}

menu primary_menu {
  section {
    item (_("_Open…"), "win.open")
    item (_("_Save"), "win.save")
    item (_("Save _As…"), "win.save-as")
    item (_("_Export…"), "win.export")
  }

  section {
    item {
      label: _("_Undo");
      action: "win.undo";
      accel: "<Control>z";
    }
    item {
      label: _("_Redo");
      action: "win.redo";
      accel: "<Control><Shift>z";
    }
  }

  section {
    item (_("_Markup"), "win.markup")
    item (_("Ad_just Size…"), "win.adjust-size")
    item (_("_Crop to Selection"), "win.crop")
    item {
      label: _("Select _All");
      action: "win.select-all";
      accel: "<Control>a";
    }

    submenu {
      label: _("Selection _Ratio");

      item {
        label: _("Free");
        action: "win.selection-ratio";
        target: "free";
      }

      item {
        label: _("Original");
        action: "win.selection-ratio";
        target: "original";
      }

      item {
        label: _("1:1 (Square)");
        action: "win.selection-ratio";
        target: "1:1";
      }

      item {
        label: _("4:3");
        action: "win.selection-ratio";
        target: "4:3";
      }

      item {
        label: _("16:9");
        action: "win.selection-ratio";
        target: "16:9";
      }
    }
  }

  section {
    item (_("Rotate _Left"), "win.rotate-left")
    item (_("Rotate _Right"), "win.rotate-right")
    item (_("Flip _Horizontal"), "win.flip-horizontal")
    item (_("Flip _Vertical"), "win.flip-vertical")
  }

  section {
    item (_("Actual _Size"), "win.zoom-actual")
    item (_("Zoom to _Fit"), "win.zoom-fit")
    item (_("_Full Screen"), "win.fullscreen")
  }

  section {
    item (_("_About Glance"), "app.about")
  }
}
