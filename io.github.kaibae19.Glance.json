{
  "id": "io.github.kaibae19.Glance",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "glance",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--filesystem=host"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/pkgconfig",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "python3-pillow",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} --no-build-isolation pillow"
      ],
      "sources": [
        {
          "type": "file",
          "only-arches": [
            "x86_64"
          ],
          "url": "https://files.pythonhosted.org/packages/d1/ee/c85a38a9ab92037a75615aba572c85ea51e605265036e00c5b67dfafbfe2/pillow-12.1.1-cp314-cp314-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl",
          "sha256": "a37691702ed687799de29a518d63d4682d9016932db66d4e90c345831b02fb4e"
        },
        {
          "type": "file",
          "only-arches": [
            "aarch64"
          ],
          "url": "https://files.pythonhosted.org/packages/5a/d6/17824509146e4babbdabf04d8171491fa9d776f7061ff6e727522df9bd03/pillow-12.1.1-cp314-cp314-manylinux_2_27_aarch64.manylinux_2_28_aarch64.whl",
          "sha256": "b574c51cf7d5d62e9be37ba446224b59a2da26dc4c1bb2ecbe936a4fb1a7cb7f"
        }
      ]
    },
    {
      "name": "poppler",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DENABLE_GLIB=ON",
        "-DENABLE_GOBJECT_INTROSPECTION=ON",
        "-DENABLE_CPP=OFF",
        "-DENABLE_QT5=OFF",
        "-DENABLE_QT6=OFF",
        "-DENABLE_UTILS=OFF",
        "-DENABLE_BOOST=OFF",
        "-DENABLE_LIBCURL=OFF",
        "-DENABLE_NSS3=OFF",
        "-DENABLE_GPGME=OFF",
        "-DENABLE_GTK_DOC=OFF",
        "-DBUILD_GTK_TESTS=OFF",
        "-DBUILD_QT5_TESTS=OFF",
        "-DBUILD_QT6_TESTS=OFF",
        "-DBUILD_CPP_TESTS=OFF",
        "-DBUILD_MANUAL_TESTS=OFF",
        "-DENABLE_LIBOPENJPEG=openjpeg2"
      ],
      "cleanup": [
        "/bin",
        "/include",
        "/lib/pkgconfig",
        "/share/gir-1.0"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://poppler.freedesktop.org/poppler-26.10.0.tar.xz",
          "sha256": "6792cb7c69205007ad87d2e936cecc5b3a31fac29ab54ffc3175fdb6b2a6ce35"
        }
      ]
    },
    {
      "name": "python3-pypdf",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} --no-build-isolation pypdf"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/a5/7e/c85f41243086a8fe5d1baeba527cb26a1918158a565932b41e0f7c0b32e9/pypdf-6.9.2-py3-none-any.whl",
          "sha256": "662cf29bcb419a36a1365232449624ab40b7c2d0cfc28e54f42eeecd1fd7e844"
        }
      ]
    },
    {
      "name": "glance",
      "buildsystem": "meson",
      "config-opts": [
        "-Dtests=false"
      ],
      "sources": [
        {
          "type": "dir",
          "path": ".",
          "skip": [
            "_build",
            "_install",
            ".flatpak-builder",
            "flatpak-build",
            "flatpak-repo"
          ]
        }
      ]
    }
  ]
}
