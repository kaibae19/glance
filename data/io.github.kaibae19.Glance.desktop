[Desktop Entry]
Name=Glance
Comment=View and quickly edit images
Exec=glance %U
Icon=io.github.kaibae19.Glance
Terminal=false
Type=Application
Categories=Graphics;Viewer;GTK;GNOME;
Keywords=image;photo;viewer;preview;resize;crop;
MimeType=image/png;image/jpeg;image/webp;image/gif;image/tiff;image/bmp;image/x-icon;image/avif;
StartupNotify=true
