#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Screenshot Glance in a throwaway headless GNOME Shell.
# Usage: scripts/headless-shot out.png [image…]    (run scripts/dev or meson install first)
set -e
root=$(cd "$(dirname "$0")/.." && pwd)
out=$(realpath "$1"); shift
GLANCE_SCREENSHOT="$out" exec "$root/scripts/headless-run" "$root/_install/bin/glance" "$@"
