#!/bin/sh
# Screenshot Glance in a throwaway headless GNOME Shell (no login needed).
# Usage: scripts/headless-shot out.png [image…]    (run scripts/dev or meson install first)
set -e
out=$(realpath "$1"); shift
root=$(cd "$(dirname "$0")/.." && pwd)
export XDG_RUNTIME_DIR=$(mktemp -d)
trap 'rm -rf "$XDG_RUNTIME_DIR"' EXIT
dbus-run-session -- sh -c '
  gnome-shell --headless --wayland --no-x11 --virtual-monitor 1280x800 --wayland-display glance-wl \
    >"$XDG_RUNTIME_DIR/shell.log" 2>&1 &
  for i in $(seq 50); do [ -S "$XDG_RUNTIME_DIR/glance-wl" ] && break; sleep 0.2; done
  WAYLAND_DISPLAY=glance-wl GDK_BACKEND=wayland GLANCE_SCREENSHOT="$0" timeout 20 "$1/_install/bin/glance" "$@" || true
  kill %1
' "$out" "$root" "$@"
