#!/bin/sh
# Run a command against a throwaway headless GNOME Shell (no login needed). A temporary HOME keeps the
# user's extensions, indexer and accounts out of it. Usage: scripts/headless-run CMD [ARG…]
set -e
tmp=$(mktemp -d)
mkdir -m 700 "$tmp/run" "$tmp/home"
cleanup() {
  fusermount3 -uz "$tmp/run/doc" 2>/dev/null || fusermount -uz "$tmp/run/doc" 2>/dev/null || true
  rm -rf "$tmp"
}
trap cleanup EXIT
export XDG_RUNTIME_DIR="$tmp/run" HOME="$tmp/home"
unset XDG_CONFIG_HOME XDG_DATA_HOME XDG_CACHE_HOME XDG_STATE_HOME
dbus-run-session -- sh -c '
  gnome-shell --headless --wayland --no-x11 --virtual-monitor 1280x800 --wayland-display glance-wl \
    >"$XDG_RUNTIME_DIR/shell.log" 2>&1 &
  shell=$!
  for i in $(seq 50); do [ -S "$XDG_RUNTIME_DIR/glance-wl" ] && break; sleep 0.2; done
  rc=0
  WAYLAND_DISPLAY=glance-wl GDK_BACKEND=wayland timeout 60 "$@" || rc=$?
  kill $shell 2>/dev/null || true
  wait $shell 2>/dev/null || true
  exit $rc
' sh "$@"
