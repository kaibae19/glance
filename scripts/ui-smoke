#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Headless UI smoke test of the installed build (scripts/dev or meson install first). Leaves screenshots in $1.
set -e
root=$(cd "$(dirname "$0")/.." && pwd)
work=$(realpath "${1:-$(mktemp -d)}")
mkdir -p "$work"
exec "$root/scripts/headless-run" python3 "$root/tests/ui_smoke.py" "$root/_install/share/glance" "$work"
